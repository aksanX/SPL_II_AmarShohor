# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Cloudflare Turnstile CAPTCHA on sign-up, login and password reset (stops scripted fake accounts).
# Get a free site key at dash.cloudflare.com → Turnstile, and put the secret key in
# Supabase → Authentication → Bot and Abuse Protection. Leave empty to turn the CAPTCHA off.
VITE_TURNSTILE_SITE_KEY=
